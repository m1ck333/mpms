# MPMS deploy config — copy to `.env` (gitignored) and fill in.
# Used by ./deploy.sh for both staging (alblue) and pilot (algreen).

# Deploy hosts (same droplet, different logical env).
DEPLOY_HOST_STAGING=46.101.166.137
DEPLOY_HOST_PILOT=46.101.166.137

# SSH user + optional key path for rsync/ssh to the droplet.
DEPLOY_USER=root
# DEPLOY_SSH_KEY=/Users/you/.ssh/id_ed25519

# Optional: enables Sentry source-map upload on FE builds (readable stack
# traces instead of minified). Create at Sentry → Auth Tokens
# (scopes: project:releases + org:read). If unset, the build skips upload.
# SENTRY_AUTH_TOKEN=

# Optional: flip tablet offline-writes ON for a staging build only
# (pilot always stays off). Default false.
# VITE_OFFLINE_WRITES=true
